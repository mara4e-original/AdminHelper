<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================== ПАЛИТРА: ОСЕНЬ ====================== -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF6E9"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#D9F0D2B8"/>
    <SolidColorBrush x:Key="TextMuted" Color="#99E9C9A5"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#C9E27F"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FFC857"/>
    <SolidColorBrush x:Key="BadBrush" Color="#FF6F61"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF8A3D" Offset="0"/>
        <GradientStop Color="#FFC857" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7A5C" Offset="0"/>
        <GradientStop Color="#D63A2F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OkGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D4E87F" Offset="0"/>
        <GradientStop Color="#8FB04A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFC857" Offset="0"/>
        <GradientStop Color="#FF7A2F" Offset="1"/>
    </LinearGradientBrush>

    <!-- Стекло: лёгкая заливка + светящаяся кромка -->
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3CFFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.55"/>
        <GradientStop Color="#26FFE2B8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#90FFFFFF" Offset="0"/>
        <GradientStop Color="#22FFFFFF" Offset="0.5"/>
        <GradientStop Color="#55FFD9A0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavActiveFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66FF9F43" Offset="0"/>
        <GradientStop Color="#26FFC857" Offset="1"/>
    </LinearGradientBrush>

    <!-- Выделение в таблицах/текстовых полях -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#55FF9F43"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF6E9"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#44FF9F43"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFF6E9"/>

    <!-- ====================== ТЕКСТ ====================== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="PageSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="Margin" Value="0,4,0,18"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CardLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    </Style>
    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="Margin" Value="4,10,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="NavIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ====================== СТЕКЛЯННАЯ КАРТОЧКА ====================== -->
    <Style x:Key="Glass" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassFill}"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="GlassChip" TargetType="Border">
        <Setter Property="Background" Value="#1FFFFFFF"/>
        <Setter Property="BorderBrush" Value="#38FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
    </Style>

    <!-- ====================== КНОПКИ ====================== -->
    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="#2EFFFFFF"/>
        <Setter Property="BorderBrush" Value="#55FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19"/>
                        <Border x:Name="hl" Background="White" Opacity="0" CornerRadius="19" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hl" Property="Opacity" Value="0.2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hl" Property="Opacity" Value="0.06"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
        <Setter Property="Foreground" Value="#3A1206"/>
        <Setter Property="BorderBrush" Value="#88FFFFFF"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="{StaticResource DangerGradient}"/>
        <Setter Property="Foreground" Value="#FFF6E9"/>
        <Setter Property="BorderBrush" Value="#88FFFFFF"/>
    </Style>
    <Style x:Key="OkButton" TargetType="Button" BasedOn="{StaticResource GlassButton}">
        <Setter Property="Background" Value="{StaticResource OkGradient}"/>
        <Setter Property="Foreground" Value="#26300A"/>
        <Setter Property="BorderBrush" Value="#88FFFFFF"/>
    </Style>
    <Style x:Key="BigAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Height" Value="48"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="30,0"/>
    </Style>

    <Style x:Key="GlassToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="#2EFFFFFF"/>
        <Setter Property="BorderBrush" Value="#55FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19"/>
                        <Border x:Name="hl" Background="White" Opacity="0" CornerRadius="19" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hl" Property="Opacity" Value="0.2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                <Setter Property="Foreground" Value="#3A1206"/>
                <Setter Property="BorderBrush" Value="#88FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GlassTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="#2EFFFFFF"/>
        <Setter Property="BorderBrush" Value="#55FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19"/>
                        <Border x:Name="hl" Background="White" Opacity="0" CornerRadius="19" IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hl" Property="Opacity" Value="0.2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                <Setter Property="Foreground" Value="#3A1206"/>
                <Setter Property="BorderBrush" Value="#88FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="0,2">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="16" Height="46"/>
                        <ContentPresenter VerticalAlignment="Center" Margin="14,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NavActiveFill}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#80FFD9A0"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== ПОЛЯ ВВОДА ====================== -->
    <Style x:Key="GlassTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="CaretBrush" Value="#FFC857"/>
        <Setter Property="SelectionBrush" Value="#66FF9F43"/>
        <Setter Property="Background" Value="#22FFFFFF"/>
        <Setter Property="BorderBrush" Value="#44FFFFFF"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="0,0,12,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="19"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" Focusable="False"/>
                        <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="#CCFFB45A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ConsoleOut" TargetType="TextBox">
        <Setter Property="Foreground" Value="#FFE9CC"/>
        <Setter Property="CaretBrush" Value="#FFC857"/>
        <Setter Property="SelectionBrush" Value="#66FF9F43"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== ПРОГРЕСС ====================== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource BarGradient}"/>
        <Setter Property="Background" Value="#26FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="5"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="5" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== СКРОЛЛБАР ====================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#66FFE2C2" CornerRadius="4" Margin="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollTrackButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollTrackButton}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollTrackButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollTrackButton}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ====================== ТАБЛИЦЫ ====================== -->
    <Style x:Key="GlassHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <TextBlock x:Name="arrow" Grid.Column="1" Margin="6,0,0,0" FontSize="9"
                                       Foreground="#FFC857" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="arrow" Property="Text" Value="▲"/>
                            <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="arrow" Property="Text" Value="▼"/>
                            <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlassCell" TargetType="DataGridCell">
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Закруглённая «стеклянная» полоса под заголовками таблицы -->
    <Style x:Key="HeaderStrip" TargetType="Border">
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Background" Value="#2E000000"/>
        <Setter Property="BorderBrush" Value="#22FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- Строка таблицы с закруглённой подсветкой -->
    <ControlTemplate x:Key="GlassRowTemplate" TargetType="DataGridRow">
        <Border Background="{TemplateBinding Background}" CornerRadius="12" Margin="0,1" SnapsToDevicePixels="True">
            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
        </Border>
    </ControlTemplate>

    <Style x:Key="GlassRow" TargetType="DataGridRow">
        <Setter Property="Template" Value="{StaticResource GlassRowTemplate}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#18FFFFFF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#40FF9F43"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Строка с подсветкой риска (нужно свойство Level: 0 / 1 / 2) -->
    <Style x:Key="GlassRowRisk" TargetType="DataGridRow">
        <Setter Property="Template" Value="{StaticResource GlassRowTemplate}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="1">
                <Setter Property="Background" Value="#14FFC857"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="2">
                <Setter Property="Background" Value="#2AFF5D5D"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#22FFFFFF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#48FF9F43"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="ColumnHeaderHeight" Value="38"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource GlassHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource GlassCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource GlassRow}"/>
    </Style>
</ResourceDictionary>
