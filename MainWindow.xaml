<Window x:Class="AdminHelper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Helper" Height="780" Width="1280" MinHeight="660" MinWidth="1060"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        Foreground="{StaticResource TextPrimary}">

    <!-- Закатное небо -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2B0A08" Offset="0"/>
            <GradientStop Color="#5A1D10" Offset="0.45"/>
            <GradientStop Color="#9C3E17" Offset="0.8"/>
            <GradientStop Color="#C9692A" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <!-- Медленно плывущие осенние «огни» за стеклом -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                    <DoubleAnimation Storyboard.TargetName="OrbGold" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="0" To="-160" Duration="0:0:16">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="OrbRust" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="-140" Duration="0:0:19">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="OrbCrimson" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                     From="0" To="200" Duration="0:0:22">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="OrbOlive" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="0" To="120" Duration="0:0:17">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- ====== ФОН: светящиеся пятна ====== -->
        <Grid IsHitTestVisible="False">
            <Ellipse x:Name="OrbGold" Width="620" Height="620" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-220,-160,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#E6FFB703" Offset="0"/>
                        <GradientStop Color="#66FF8C00" Offset="0.5"/>
                        <GradientStop Color="#00FF8C00" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="OrbRust" Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-180,0,0,-200">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#CCE8590C" Offset="0"/>
                        <GradientStop Color="#55D9480F" Offset="0.55"/>
                        <GradientStop Color="#00D9480F" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="OrbCrimson" Width="480" Height="480" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="260,60,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#AAB3261E" Offset="0"/>
                        <GradientStop Color="#44B3261E" Offset="0.55"/>
                        <GradientStop Color="#00B3261E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="OrbOlive" Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,120,-100">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#99B5A642" Offset="0"/>
                        <GradientStop Color="#33B5A642" Offset="0.55"/>
                        <GradientStop Color="#00B5A642" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- ====== ИНТЕРФЕЙС ====== -->
        <Grid x:Name="MainUi" Margin="18" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MainShift" Y="24"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковая панель -->
            <Border Style="{StaticResource Glass}" Padding="14,18">
                <DockPanel LastChildFill="True">
                    <!-- Бренд -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,22">
                        <Grid Width="34" Height="30" Margin="0,0,10,0">
                            <Path Data="M 2,26 C 2,10 14,2 30,2 C 30,18 20,30 2,26 Z" Fill="{StaticResource AccentGradient}"/>
                            <Path Data="M 4,24 L 22,10" Stroke="#99FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                        <TextBlock Text="Admin Helper" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <!-- Права -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource GlassChip}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Режим" Style="{StaticResource CardLabel}" FontSize="11"/>
                            <TextBlock x:Name="AdminBadgeText" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel>
                        <RadioButton x:Name="NavDashboard" Tag="Dashboard" GroupName="nav" IsChecked="True"
                                     Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE80F;"/>
                                <TextBlock Text="Дашборд" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavServices" Tag="Services" GroupName="nav"
                                     Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE713;"/>
                                <TextBlock Text="Службы" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavProcesses" Tag="Processes" GroupName="nav"
                                     Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE71D;"/>
                                <TextBlock Text="Процессы" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavNetwork" Tag="Network" GroupName="nav"
                                     Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE774;"/>
                                <TextBlock Text="Сеть" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavConsole" Tag="Console" GroupName="nav"
                                     Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE756;"/>
                                <TextBlock Text="Консоль" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavStartup" Tag="Startup" GroupName="nav"
                                     Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE7E8;"/>
                                <TextBlock Text="Автозагрузка" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavOptimize" Tag="Optimize" GroupName="nav"
                                     Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE945;"/>
                                <TextBlock Text="Оптимизация" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSecurity" Tag="Security" GroupName="nav"
                                     Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xEA18;"/>
                                <TextBlock Text="Защита" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavUpdate" Tag="Update" GroupName="nav"
                                     Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource NavIcon}" Text="&#xE895;"/>
                                <TextBlock x:Name="NavUpdText" Text="Обновления" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Страницы -->
            <Grid Grid.Column="1" Margin="22,0,0,0">

                <!-- ======== Дашборд ======== -->
                <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock x:Name="GreetingText" Text="Привет!" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="InfoText" Style="{StaticResource PageSub}"/>

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Style="{StaticResource Glass}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Процессор" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="CpuText" Text="0%" Style="{StaticResource BigNumber}"/>
                                    <TextBlock x:Name="CpuDetail" Style="{StaticResource CardLabel}" FontSize="12" Margin="0,0,0,10"/>
                                    <ProgressBar x:Name="CpuBar" Maximum="100"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Glass}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Оперативная память" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="RamText" Text="0%" Style="{StaticResource BigNumber}"/>
                                    <TextBlock x:Name="RamDetail" Style="{StaticResource CardLabel}" FontSize="12" Margin="0,0,0,10"/>
                                    <ProgressBar x:Name="RamBar" Maximum="100"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Style="{StaticResource Glass}" Padding="20,16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Процессов запущено" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="ProcCountText" Text="—" Style="{StaticResource BigNumber}" FontSize="30"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Glass}" Padding="20,16" Margin="8,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Активных соединений" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="ConnCountText" Text="—" Style="{StaticResource BigNumber}" FontSize="30"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Glass}" Padding="20,16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Права доступа" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="AdminText" Text="—" Style="{StaticResource BigNumber}" FontSize="22" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Glass}">
                            <StackPanel>
                                <TextBlock Text="Диски" Style="{StaticResource CardLabel}" Margin="0,0,0,14"/>
                                <ItemsControl x:Name="DisksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,16">
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Info}" Style="{StaticResource CardLabel}" FontSize="12" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======== Службы ======== -->
                <Grid x:Name="ServicesPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Службы" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Запуск, остановка и перезапуск служб Windows" Style="{StaticResource PageSub}"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,2">
                        <TextBox x:Name="ServiceSearch" Style="{StaticResource GlassTextBox}" Width="260"
                                 Tag="Поиск по названию…" TextChanged="ServiceSearch_TextChanged"/>
                        <Button Style="{StaticResource OkButton}" Content="Запустить" Click="StartService_Click"/>
                        <Button Style="{StaticResource DangerButton}" Content="Остановить" Click="StopService_Click"/>
                        <Button Style="{StaticResource AccentButton}" Content="Перезапустить" Click="RestartService_Click"/>
                        <Button Style="{StaticResource GlassButton}" Content="Обновить" Click="RefreshServices_Click"/>
                    </WrapPanel>

                    <Border Grid.Row="2" Style="{StaticResource Glass}" Padding="8">
                        <Grid>
                        <Border Style="{StaticResource HeaderStrip}"/>
                        <DataGrid x:Name="ServicesGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding DisplayName}" Width="*"/>
                                <DataGridTextColumn Header="Имя службы" Binding="{Binding Name}" Width="190"/>
                                <DataGridTextColumn Header="Состояние" Binding="{Binding StatusText}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Запуск" Binding="{Binding StartTypeText}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Border>

                    <TextBlock x:Name="ServicesStatus" Grid.Row="3" Style="{StaticResource Caption}"/>
                </Grid>

                <!-- ======== Процессы ======== -->
                <Grid x:Name="ProcessesPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Процессы" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Все запущенные программы. Подозрительные поднимаются наверх и подсвечиваются." Style="{StaticResource PageSub}"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,2">
                        <TextBox x:Name="ProcSearch" Style="{StaticResource GlassTextBox}" Width="240"
                                 Tag="Имя, PID или путь…" TextChanged="ProcSearch_TextChanged"/>
                        <ToggleButton x:Name="ProcSuspOnly" Style="{StaticResource GlassToggle}" Content="Только подозрительные"
                                      Checked="ProcFilter_Changed" Unchecked="ProcFilter_Changed"/>
                        <Button Style="{StaticResource DangerButton}" Content="Завершить процесс" Click="KillProcess_Click"/>
                        <Button Style="{StaticResource GlassButton}" Content="Открыть папку" Click="OpenProcFolder_Click"/>
                        <Button Style="{StaticResource GlassButton}" Content="Обновить" Click="RefreshProcesses_Click"/>
                    </WrapPanel>

                    <Border Grid.Row="2" Style="{StaticResource Glass}" Padding="8">
                        <Grid>
                        <Border Style="{StaticResource HeaderStrip}"/>
                        <DataGrid x:Name="ProcGrid" RowStyle="{StaticResource GlassRowRisk}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Процесс" Binding="{Binding Name}" Width="190"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                                <DataGridTextColumn Header="Память" Binding="{Binding MemoryMb, StringFormat={}{0:N0} МБ}" Width="110"/>
                                <DataGridTextColumn Header="Оценка" Binding="{Binding Verdict}" SortMemberPath="Level" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="1">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="2">
                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Подробности" Binding="{Binding Details}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Path}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Border>

                    <TextBlock x:Name="ProcStatus" Grid.Row="3" Style="{StaticResource Caption}"/>
                </Grid>

                <!-- ======== Сеть ======== -->
                <Grid x:Name="NetworkPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Сеть" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Адаптеры и TCP-соединения: какая программа с кем разговаривает" Style="{StaticResource PageSub}"/>
                    </StackPanel>

                    <ItemsControl x:Name="AdaptersList" Grid.Row="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassChip}" MinWidth="230">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Info}" Style="{StaticResource CardLabel}" FontSize="12" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding Traffic}" Foreground="{StaticResource WarnBrush}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Grid.Row="2" Margin="0,4,0,2">
                        <TextBox x:Name="NetSearch" Style="{StaticResource GlassTextBox}" Width="240"
                                 Tag="Процесс, адрес или порт…" TextChanged="NetSearch_TextChanged"/>
                        <ToggleButton x:Name="NetEstOnly" Style="{StaticResource GlassToggle}" Content="Только установленные"
                                      Checked="NetFilter_Changed" Unchecked="NetFilter_Changed"/>
                        <Button Style="{StaticResource DangerButton}" Content="Завершить процесс" Click="KillNetProcess_Click"/>
                        <Button Style="{StaticResource GlassButton}" Content="Обновить" Click="RefreshNetwork_Click"/>
                    </WrapPanel>

                    <Border Grid.Row="3" Style="{StaticResource Glass}" Padding="8">
                        <Grid>
                        <Border Style="{StaticResource HeaderStrip}"/>
                        <DataGrid x:Name="NetGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Процесс" Binding="{Binding Process}" Width="180"/>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                                <DataGridTextColumn Header="Локальный адрес" Binding="{Binding Local}" Width="200"/>
                                <DataGridTextColumn Header="Удалённый адрес" Binding="{Binding Remote}" Width="*"/>
                                <DataGridTextColumn Header="Состояние" Binding="{Binding State}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEstablished}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Border>

                    <TextBlock x:Name="NetStatus" Grid.Row="4" Style="{StaticResource Caption}"/>
                </Grid>

                <!-- ======== Консоль ======== -->
                <Grid x:Name="ConsolePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Консоль" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Команды выполняются через cmd.exe. Стрелки ↑ ↓ — история, cd работает. Для PowerShell: powershell -c &quot;…&quot;" Style="{StaticResource PageSub}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Glass}" Padding="18,14">
                        <TextBox x:Name="ConsoleOutput" Style="{StaticResource ConsoleOut}"/>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ConsolePrompt" VerticalAlignment="Center" Margin="4,0,10,10"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource WarnBrush}"
                                   MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                        <TextBox x:Name="ConsoleInput" Grid.Column="1" Style="{StaticResource GlassTextBox}"
                                 FontFamily="Cascadia Mono, Consolas" Tag="Введите команду и нажмите Enter"
                                 PreviewKeyDown="ConsoleInput_PreviewKeyDown"/>
                        <Button x:Name="ConsoleRunBtn" Grid.Column="2" Style="{StaticResource AccentButton}" Content="Выполнить" Click="ConsoleRun_Click"/>
                        <Button x:Name="ConsoleStopBtn" Grid.Column="3" Style="{StaticResource DangerButton}" Content="Стоп" IsEnabled="False" Click="ConsoleStop_Click"/>
                        <Button Grid.Column="4" Style="{StaticResource GlassButton}" Content="Очистить" Margin="0,0,0,10" Click="ConsoleClear_Click"/>
                    </Grid>
                </Grid>

                <!-- ======== Автозагрузка ======== -->
                <Grid x:Name="StartupPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Автозагрузка" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Реестр и папка автозагрузки показаны отдельно. Проверяем пути, подписи и странные параметры; записи без файла можно удалить." Style="{StaticResource PageSub}"/>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,2">
                        <RadioButton x:Name="StartupTabReg" GroupName="startupTabs" IsChecked="True"
                                     Style="{StaticResource GlassTab}" Content="Реестр" Checked="StartupTab_Changed"/>
                        <RadioButton x:Name="StartupTabFolder" GroupName="startupTabs"
                                     Style="{StaticResource GlassTab}" Content="Папка автозагрузки" Checked="StartupTab_Changed"/>
                        <TextBox x:Name="StartupSearch" Style="{StaticResource GlassTextBox}" Width="220"
                                 Tag="Название или команда…" TextChanged="StartupSearch_TextChanged"/>
                        <ToggleButton x:Name="StartupSuspOnly" Style="{StaticResource GlassToggle}" Content="Только подозрительные"
                                      Checked="StartupFilter_Changed" Unchecked="StartupFilter_Changed"/>
                        <Button Style="{StaticResource DangerButton}" Content="Убрать из автозагрузки" Click="RemoveStartup_Click"/>
                        <Button x:Name="StartupCleanBtn" Style="{StaticResource DangerButton}" Content="Удалить без файла" Click="CleanMissingStartup_Click"/>
                        <Button Style="{StaticResource GlassButton}" Content="Показать файл" Click="OpenStartupFolder_Click"/>
                        <Button Style="{StaticResource GlassButton}" Content="Обновить" Click="RefreshStartup_Click"/>
                    </WrapPanel>

                    <Border Grid.Row="2" Style="{StaticResource Glass}" Padding="8">
                        <Grid>
                        <Border Style="{StaticResource HeaderStrip}"/>
                        <DataGrid x:Name="StartupGrid" RowStyle="{StaticResource GlassRowRisk}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="190"/>
                                <DataGridTextColumn Header="Где найдено" Binding="{Binding Location}" Width="230"/>
                                <DataGridTextColumn Header="Оценка" Binding="{Binding Verdict}" SortMemberPath="Level" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="1">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="2">
                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Подробности" Binding="{Binding Details}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Command}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Border>

                    <TextBlock x:Name="StartupStatus" Grid.Row="3" Style="{StaticResource Caption}"/>
                </Grid>

                <!-- ======== Оптимизация (шуточная) ======== -->
                <Grid x:Name="OptimizePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Оптимизация" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Одним нажатием ускорьте систему до небывалых высот" Style="{StaticResource PageSub}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Glass}" Padding="26,22" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="OptStatusText" Text="Готово к оптимизации" FontSize="18" FontWeight="SemiBold"/>
                                <ProgressBar x:Name="OptBar" Maximum="100" Margin="0,14,0,0"/>
                            </StackPanel>
                            <Button x:Name="OptimizeBtn" Grid.Column="1" Style="{StaticResource BigAccentButton}"
                                    Content="Оптимизировать" Margin="28,0,0,0" VerticalAlignment="Center"
                                    Click="Optimize_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Glass}" Padding="18,14">
                        <TextBox x:Name="OptLog" Style="{StaticResource ConsoleOut}"/>
                    </Border>
                </Grid>

                <!-- ======== Обновления ======== -->
                <Grid x:Name="UpdatePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Обновления" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Проверка новых версий на GitHub и установка в один клик" Style="{StaticResource PageSub}"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Glass}" Padding="26,22" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="UpdStatusText" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UpdCurrent" Style="{StaticResource CardLabel}" FontSize="12" Margin="0,4,0,0"/>
                            <ProgressBar x:Name="UpdBar" Maximum="100" Margin="0,14,0,16"/>
                            <WrapPanel>
                                <Button x:Name="UpdCheckBtn" Style="{StaticResource GlassButton}"
                                        Content="Проверить обновления" Click="CheckUpdate_Click"/>
                                <Button x:Name="UpdInstallBtn" Style="{StaticResource AccentButton}"
                                        Content="Скачать и установить" Click="InstallUpdate_Click"/>
                                <Button Style="{StaticResource GlassButton}"
                                        Content="Страница релизов" Click="OpenReleasePage_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Glass}" Padding="18,14">
                        <TextBox x:Name="UpdNotes" Style="{StaticResource ConsoleOut}"/>
                    </Border>
                </Grid>

                <!-- ======== Защита ======== -->
                <ScrollViewer x:Name="SecurityPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Защита" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Быстрая проверка системы и запуск средства Windows для поиска вредоносных программ" Style="{StaticResource PageSub}"/>

                        <Border Style="{StaticResource Glass}" Padding="32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="130" Height="130" Margin="0,0,32,0" VerticalAlignment="Top">
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#CCFFC857" Offset="0"/>
                                                <GradientStop Color="#66FF8A3D" Offset="0.6"/>
                                                <GradientStop Color="#00FF8A3D" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="&#xEA18;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="64"
                                               Foreground="#FFF6E9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Защита системы" FontSize="24" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SecStatusText" Text="Нажмите «Быстрая проверка», чтобы просмотреть процессы и автозагрузку, а затем запустить проверку Windows."
                                               Style="{StaticResource CardLabel}" TextWrapping="Wrap" Margin="0,6,0,18"/>
                                    <ProgressBar x:Name="ScanBar" Maximum="100" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="ScanText" Style="{StaticResource Caption}" Margin="0,0,0,16"/>
                                    <WrapPanel>
                                        <Button x:Name="QuickScanBtn" Style="{StaticResource BigAccentButton}" Content="Быстрая проверка" Click="QuickScan_Click"/>
                                        <Button Style="{StaticResource GlassButton}" Height="48" Content="Безопасность Windows" Click="OpenDefender_Click"/>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,0"
                                               Text="После проверки откроется средство удаления вредоносных программ Microsoft (mrt.exe), то же самое, что Win+R → mrt. Windows спросит разрешение администратора."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="3" Margin="0,16,0,16">
                            <Border Style="{StaticResource Glass}" Padding="20,16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Подозрительные процессы" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="SecProcText" Text="—" Style="{StaticResource BigNumber}" FontSize="30"/>
                                    <Button Style="{StaticResource GlassButton}" Content="Посмотреть" Margin="0,10,0,0" HorizontalAlignment="Left" Click="SecShowProcs_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Glass}" Padding="20,16" Margin="8,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Автозагрузка под вопросом" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="SecAutoText" Text="—" Style="{StaticResource BigNumber}" FontSize="30"/>
                                    <Button Style="{StaticResource GlassButton}" Content="Посмотреть" Margin="0,10,0,0" HorizontalAlignment="Left" Click="SecShowStartup_Click"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Glass}" Padding="20,16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Активных соединений" Style="{StaticResource CardLabel}"/>
                                    <TextBlock x:Name="SecNetText" Text="—" Style="{StaticResource BigNumber}" FontSize="30"/>
                                    <Button Style="{StaticResource GlassButton}" Content="Посмотреть" Margin="0,10,0,0" HorizontalAlignment="Left" Click="SecShowNet_Click"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Style="{StaticResource Caption}" Margin="4,0,0,12"
                                   Text="Наши проверки — эвристика (путь запуска, подпись файла, похожие на системные имена, скрытые параметры). Они подсказывают, куда посмотреть, но не заменяют антивирус."/>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </Grid>

        <!-- ====== ЗАСТАВКА: приветствие и имя компьютера ====== -->
        <Grid x:Name="IntroLayer" Background="Transparent" MouseLeftButtonDown="Intro_MouseDown">
            <Border x:Name="IntroCard" Style="{StaticResource Glass}" CornerRadius="34" Padding="56,44"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="IntroShift" Y="30"/>
                </Border.RenderTransform>
                <StackPanel Width="520" HorizontalAlignment="Center">
                    <Viewbox Width="84" Height="75" HorizontalAlignment="Center">
                        <Grid Width="34" Height="30">
                            <Path Data="M 2,26 C 2,10 14,2 30,2 C 30,18 20,30 2,26 Z" Fill="{StaticResource AccentGradient}"/>
                            <Path Data="M 4,24 L 22,10" Stroke="#99FFFFFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Viewbox>
                    <TextBlock x:Name="IntroHello" FontSize="46" FontWeight="SemiBold" Height="64"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,20,0,4"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="IntroPc" FontSize="18" Height="26" HorizontalAlignment="Center" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="нажмите, чтобы пропустить" FontSize="11" HorizontalAlignment="Center"
                               Margin="0,22,0,0" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
